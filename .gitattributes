# 기본: Git이 text/binary를 자동 판별하고, text 파일은 저장소에 LF로 저장
* text=auto

# 코드·문서·설정 파일은 OS와 관계없이 항상 LF
*.py    text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.txt   text eol=lf

# Windows 전용 스크립트는 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# binary: 줄바꿈 변환·텍스트 diff 대상에서 제외
*.jpg   binary
*.jpeg  binary
*.png   binary
*.bmp   binary
*.webp  binary
*.zip   binary
*.pt    binary
*.pth   binary
*.onnx  binary
