# ---------------------------------------------------------------
# 데이터: 원본/가공 데이터는 저장소에 포함하지 않는다 (폴더 구조만 .gitkeep으로 유지)
# ---------------------------------------------------------------
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Roboflow export 등 압축 파일
*.zip

# ---------------------------------------------------------------
# 학습/평가 결과와 모델 weight
# ---------------------------------------------------------------
outputs/*
!outputs/.gitkeep
runs/

*.pt
*.pth
*.onnx
*.engine
*.torchscript
*.tflite

# ---------------------------------------------------------------
# 로컬 설정: scripts/split_dataset.py가 PC별 절대경로로 생성함
# (공유용 예시는 configs/data.example.yaml)
# ---------------------------------------------------------------
configs/data.yaml

# ---------------------------------------------------------------
# Python / 개발 환경
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.env
.ipynb_checkpoints/
.vscode/
.idea/

# OS
Thumbs.db
desktop.ini
.DS_Store
